      "style": {
        "navigationBarTitleText": "设置"
      }
    },
    {
      "path": "pages/shop/detail",
      "name": "detail",
      "style": {
        "navigationBarTitleText": "详情"
      }
    },
    {
      "path": "pages/shop/view3d",
      "style": {
        "navigationBarTitleText": "3d模型",
        "enablePullDownRefresh": false
      }
    }
  ],
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "江安竹簧",
    "navigationBarBackgroundColor": "#F8F8F8",
    "enablePullDownRefresh": true,
    "backgroundColor": "#ffffff"
  },
  "tabBar": {
    "color": "#999999",
    "selectedColor": "#5a8d69",
    "backgroundColor": "#ffffff",
    "borderStyle": "black",
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "首页",
        "iconPath": "static/images/tabbar/home.png",
        "selectedIconPath": "static/images/tabbar/home-active.png"
      },
      {
        "pagePath": "pages/history/index",
        "text": "印记",
        "iconPath": "static/images/tabbar/history.png",
        "selectedIconPath": "static/images/tabbar/history-active.png"
      },
      {
        "pagePath": "pages/shop/index",
        "text": "商城",
        "iconPath": "static/images/tabbar/shop.png",
        "selectedIconPath": "static/images/tabbar/shop-active.png"
      },
      {
        "pagePath": "pages/art/index",
        "text": "艺圈",
        "iconPath": "static/images/tabbar/art.png",
        "selectedIconPath": "static/images/tabbar/art-active.png"
      },
      {
        "pagePath": "pages/user/index",
        "text": "我的",
