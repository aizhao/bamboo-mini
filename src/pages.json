      "style": {
        "navigationBarTitleText": "足迹"
      }
    },
    {
      "path": "pages/art/index",
      "style": {
        "navigationBarTitleText": "艺圈"
      }
    },
    {
      "path": "pages/shop/index",
      "style": {
        "navigationBarTitleText": "商城"
